# ─── Supabase ────────────────────────────────────────────────────────────────
# Find these at: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # "service_role" key — keep secret

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Optional. If absent, an offline stub provider is used (safe for local dev).
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── App URL ─────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://your-domain.com  (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Stripe (Phase 2 — leave blank for now) ──────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend email (Phase 2 — leave blank for now) ────────────────────────────
RESEND_API_KEY=re_...
